# ghost-dotnet-formatter Sample .editorconfig
# Place this file at the root of your solution

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.cs]
indent_size = 4
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true

[*.{fs,fsi,fsx}]
indent_size = 4

[*.{cshtml,razor}]
indent_size = 4

[*.{html,htm}]
indent_size = 2

[*.css]
indent_size = 2

[*.{js,jsx,mjs}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.sql]
indent_size = 4

[*.{xml,config,csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
